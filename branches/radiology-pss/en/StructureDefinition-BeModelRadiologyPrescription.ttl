0px 4px; padding-top: 3px; padding-bottom: 3px\" class=\"hierarchy\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Additional information about the element\">Description &amp; Constraints</a><span style=\"float: right\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Legend for this format\"><img src=\"data:image/png;base64,\" alt=\"doco\" style=\"background-color: inherit\"/></a></span></th></tr><tr style=\"border: 0px #F0F0F0 solid; padding:0px; vertical-align: top; background-color: white\"><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px; white-space: nowrap; background-image: url(tbl_bck1.png)\" class=\"hierarchy\"><img src=\"tbl_spacer.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_element.gif\" alt=\".\" style=\"background-color: white; background-color: inherit\" title=\"Element\" class=\"hierarchy\"/> <a href=\"StructureDefinition-BeModelRadiologyPrescription-definitions.html#BeModelRadiologyPrescription\" title=\"Data model for the radiology prescription referral.\">BeModelRadiologyPrescription</a><a name=\"BeModelRadiologyPrescription\"> </a></td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"/><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"><span style=\"opacity: 0.5\">0</span><span style=\"opacity: 0.5\">..</span><span style=\"opacity: 0.5\">*</span></td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"><a href=\"StructureDefinition-BeModelReferralPrescription.html\">BeModelReferralPrescription</a></td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">BeModelRadiologyPrescription<br/><br/>Elements defined in Ancestors:<a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Business identifier of the request\">identifier</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Business code allowing the healthcare professional to find a prescription associated with a patient\">shortCode</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Date of recording of the information by the Recorder.\">recordedDate</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Date of creation of the referral prescription. This date will not change throughout the process. This date corresponds to the first recordedDate recorded for this referral prescription.\">creationDate</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Is the unique identifier of the patient. The unique identifier must be: NISS, National Registry Number or Bis Patient\">patient</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Is the unique identifier of the person who encodes the prescription (e.g. a doctor, nurse, midwife or dentist) and takes responsibility for their content. The unique identifier must be: NISS, National Registry Number or Bis Requester\">author</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Is the status of the referral prescription (e.g. planned, complete, stopped, suspended, in progress, ...)\">status</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Gives the reason for the status of the referral prescription (treatment has been changed, patient is allergic, patient refuses, ...)\">statusReason</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Type of care requested (e.g. 'Compression therapy', 'Sample collection', 'CT Scan').\">careRequested</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Additional details on the requested care\">description</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Category of the requested care (nursing, radiology, ...)\">discipline</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Type of the request or prescription ('Prescription' or 'Proposal').\">type</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Reference to the ID of the original request (useful when the request is an extension of another one).\">originRequestId</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Start date of the prescription validity (encoded by the prescriber).\">validityStartDate</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"End date of the prescription validity (encoded by the prescriber)\">validityEndDate</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Medical problem or clinical context related to this request (for example: 'Open wound', 'Broken leg').\">problem</a>, <a href=\"StructureDefinition-BeModelReferralPrescription.html\" title=\"Anatomical location where the treatment should be applied (for example: 'Left arm').\">bodyLocation</a><br/><span style=\"font-weight:bold\">Instances of this type can be the target of a Reference</span></td></tr>#xD;\n<tr style=\"border: 0px #F0F0F0 solid; padding:0px; vertical-align: top; background-color: #F7F7F7\"><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px; white-space: nowrap; background-image: url(tbl_bck10.png)\" class=\"hierarchy\"><img src=\"tbl_spacer.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_datatype.gif\" alt=\".\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"Data Type\" class=\"hierarchy\"/> <a href=\"StructureDefinition-BeModelRadiologyPrescription-definitions.html#BeModelRadiologyPrescription.prescriptionType\" title=\"Additional category that can be tailored to use-case specific purposes.\">prescriptionType</a><a name=\"BeModelRadiologyPrescription.prescriptionType\"> </a></td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"/><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">0..1</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"><a href=\"http://hl7.org/fhir/R4/datatypes.html#CodeableConcept\">CodeableConcept</a></td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">Prescription type for routing and workflow purposes.</td></tr>#xD;\n<tr style=\"border: 0px #F0F0F0 solid; padding:0px; vertical-align: top; background-color: white\"><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 0px #F0F0F0 solid; padding:0px 4px 0px 4px; white-space: nowrap; background-image: url(tbl_bck10.png)\" class=\"hierarchy\"><img src=\"tbl_spacer.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_datatype.gif\" alt=\".\" style=\"background-color: white; background-color: inherit\" title=\"Data Type\" class=\"hierarchy\