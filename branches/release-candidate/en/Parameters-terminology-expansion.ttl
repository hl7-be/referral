@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://www.ehealth.fgov.be/standards/fhir/drp/Parameters/terminology-expansion> a fhir:Parameters ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "terminology-expansion"] ;
  fhir:Resource.language [ fhir:value "en"] ;
  fhir:Parameters.parameter [
     fhir:index -1 ;
     fhir:Parameters.parameter.name [ fhir:value "includeDesignations" ] ;
     fhir:Parameters.parameter.valueBoolean [ fhir:value "true"^^xsd:boolean ]
  ] .

# - ontology header ------------------------------------------------------------

<https://www.ehealth.fgov.be/standards/fhir/drp/Parameters/terminology-expansion.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

# -------------------------------------------------------------------------------------

