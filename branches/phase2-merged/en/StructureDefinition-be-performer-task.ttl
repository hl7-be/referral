           fhir:link <https://www.ehealth.fgov.be/standards/fhir/drp/StructureDefinition/be-annex-81>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Task.executionPeriod" ] ;
       fhir:path [ fhir:v "Task.executionPeriod" ] ;
       fhir:short [ fhir:v "Start and end date when the performer executed the task" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Task.authoredOn" ] ;
       fhir:path [ fhir:v "Task.authoredOn" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "be-inv-long-date" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "date SHALL contain a long date (YYYY-MM-DDThh:mm:ss+zz:zz)" ] ;
         fhir:expression [ fhir:v "empty() or toString().length()=25" ] ;
