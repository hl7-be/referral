  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Task" ] ;
       fhir:path [ fhir:v "Task" ]
     ] [
       fhir:id [ fhir:v "Task.identifier" ] ;
       fhir:path [ fhir:v "Task.identifier" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "system" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ]
     ] [
       fhir:id [ fhir:v "Task.identifier:UHMEP" ] ;
       fhir:path [ fhir:v "Task.identifier" ] ;
       fhir:sliceName [ fhir:v "UHMEP" ] ;
       fhir:short [ fhir:v "Reference ID of the UHMEP once available there" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Task.identifier:UHMEP.system" ] ;
       fhir:path [ fhir:v "Task.identifier.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:fixed [
         a fhir:uri ;
