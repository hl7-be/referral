       ] ;
       fhir:name [ fhir:v "Example 4: Nursing - Bladder care" ] ;
       fhir:description [ fhir:v "One Care Prescription - Comprehensive bladder catheter management program with maintenance visits every 6 weeks. Includes catheter replacement, bladder irrigation, urinary output monitoring, infection prevention protocols, and patient/caregiver education on proper catheter care between nursing visits." ] ;
